<body>
  <h1>Welcome to page 3</h1>

  <a href="/">Home</a>
  <a href="/page1">Page 1</a>
  <a href="/page2">Page 2</a>
  <a href="/page4">Page 4</a>

  <h2>Add a Dog</h2>
  <form action="/createDog" method="POST">
    <label for="dogName">Name:</label>
    <input type="text" id="dogName" name="name">

    <label for="dogBreed">Breed:</label>
    <input type="text" id="dogBreed" name="breed">

    <label for="dogAge">Age:</label>
    <input type="number" id="dogAge" name="age" min="0">

    <input type="submit" value="Create Dog">
  </form>

  <br/>
  <br/>

  <h2>Increase a Dog's Age</h2>
  <form action="/increaseDogAge" method="POST">
    <label for="lookupName">Dog's name:</label>
    <input type="text" id="lookupName" name="name">

    <input type="submit" value="Increase Age">
  </form>
</body>
</html>